---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags, cover } = post.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const postHref = base ? `${base}/posts/${post.id}` : `/posts/${post.id}`;

const coverSrc = cover
  ? (cover.startsWith('http') ? cover : (base ? `${base}${cover.startsWith('/') ? '' : '/'}${cover}` : cover))
  : (base ? `${base}/images/posts/welcome.svg` : '/images/posts/welcome.svg');

// Format date nicely
const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(pubDate);

// Approximate reading time from description & body if available
const wordCount = (post.body ? post.body.split(/\s+/).length : 250);
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
---

<article class="glass-panel post-card">
  <a href={postHref} class="post-media-link" tabindex="-1" aria-hidden="true">
    <img
      src={coverSrc}
      alt={title}
      loading="lazy"
      width="800"
      height="450"
      class="post-cover-image"
    />
    <div class="post-category-tag">
      <span class="badge badge-violet">{category}</span>
    </div>
  </a>

  <div class="post-card-body">
    <div class="post-meta">
      <span class="post-date">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </span>
      <span class="meta-dot">·</span>
      <span class="post-read-time">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        {readingMinutes} phút đọc
      </span>
    </div>

    <h3 class="post-title">
      <a href={postHref} class="post-title-link">{title}</a>
    </h3>

    <p class="post-desc">{description}</p>

    <div class="post-footer">
      <div class="post-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="post-tag">#{tag}</span>
        ))}
      </div>
      <a href={postHref} class="read-more-link" aria-label={`Đọc bài viết: ${title}`}>
        <span>Đọc bài</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .post-media-link {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: block;
    background-color: var(--bg-secondary);
  }

  .post-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .post-card:hover .post-cover-image {
    transform: scale(1.05);
  }

  .post-category-tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
  }

  .post-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .post-date,
  .post-read-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-dot {
    opacity: 0.4;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.65rem;
  }

  .post-title-link {
    color: var(--text-main);
    transition: color var(--transition-fast);
  }

  .post-title-link:hover {
    color: var(--accent-cyan);
  }

  .post-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.3rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .post-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .post-tag {
    font-size: 0.78rem;
    color: #94A3B8;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .read-more-link:hover {
    color: #67E8F9;
    transform: translateX(3px);
  }
</style>
