---
import BaseLayout from './BaseLayout.astro';
import '../styles/markdown.css';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, cover } = post.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const postsHref = base ? `${base}/posts/` : '/posts/';
const coverSrc = cover
  ? (cover.startsWith('http') ? cover : (base ? `${base}${cover.startsWith('/') ? '' : '/'}${cover}` : cover))
  : undefined;

const formattedPubDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;

const wordCount = post.body ? post.body.split(/\s+/).length : 300;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={`${title} — Blog`} description={description} image={cover}>
  <article class="post-detail-page">
    <div class="container">
      <!-- Back to posts link -->
      <div class="back-link-wrapper">
        <a href={postsHref} class="back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Quay lại danh sách bài viết</span>
        </a>
      </div>

      <!-- Post Header Banner -->
      <header class="post-header glass-panel">
        <div class="post-meta-top">
          <span class="badge badge-violet">{category}</span>
          <span class="post-read-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {readingMinutes} phút đọc
          </span>
        </div>

        <h1 class="post-title text-gradient">{title}</h1>
        <p class="post-summary">{description}</p>

        <div class="post-meta-dates">
          <div class="meta-item">
            <span class="meta-label">Ngày xuất bản:</span>
            <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          </div>
          {formattedUpdatedDate && (
            <div class="meta-item">
              <span class="meta-label">Cập nhật:</span>
              <time datetime={updatedDate?.toISOString()}>{formattedUpdatedDate}</time>
            </div>
          )}
        </div>

        <div class="post-header-tags">
          {tags.map((tag) => (
            <span class="badge badge-cyan">#{tag}</span>
          ))}
        </div>

        {coverSrc && (
          <div class="post-cover-wrapper">
            <img
              src={coverSrc}
              alt={title}
              width="800"
              height="450"
              class="post-cover-img"
            />
          </div>
        )}
      </header>

      <!-- Markdown Rendered Content -->
      <div class="post-body-container glass-panel">
        <div class="prose">
          <slot />
        </div>

        <div class="post-bottom-nav">
          <a href={postsHref} class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <span>Tất cả bài viết</span>
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-detail-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .back-link-wrapper {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-cyan);
    transform: translateX(-4px);
  }

  .post-header {
    padding: 2.5rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  .post-read-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .post-title {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .post-summary {
    font-size: 1.15rem;
    color: #CBD5E1;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 820px;
  }

  .post-meta-dates {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
    color: var(--text-muted);
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.2rem;
  }

  .meta-label {
    color: var(--text-dim);
    margin-right: 0.35rem;
  }

  .post-header-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-cover-wrapper {
    margin-top: 2rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    max-height: 440px;
    background-color: var(--bg-secondary);
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-body-container {
    padding: 3rem 2.5rem;
    border-radius: var(--radius-lg);
  }

  .post-bottom-nav {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 768px) {
    .post-header {
      padding: 1.5rem;
    }
    .post-body-container {
      padding: 1.8rem 1.2rem;
    }
  }
</style>
