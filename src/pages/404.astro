---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base ? `${base}/` : '/';
---

<BaseLayout
  title={`404 — Không tìm thấy trang | ${siteConfig.name}`}
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển."
>
  <div class="container not-found-page">
    <div class="glass-panel not-found-card">
      <span class="badge badge-ember">Error 404</span>
      <h1 class="code-404 text-gradient">404</h1>
      <h2 class="not-found-title">Trang không tồn tại</h2>
      <p class="not-found-desc">
        Đường dẫn bạn vừa truy cập không tồn tại, đã bị đổi tên hoặc đã được di chuyển sang một vị trí khác trong không gian số này.
      </p>

      <div class="not-found-actions">
        <a href={homeHref} class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          <span>Trở về Trang chủ</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .not-found-card {
    text-align: center;
    padding: 4rem 2.5rem;
    max-width: 580px;
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .code-404 {
    font-size: clamp(5rem, 12vw, 8rem);
    font-weight: 900;
    line-height: 1;
    margin: 1rem 0;
    letter-spacing: -0.04em;
    font-family: monospace;
  }

  .not-found-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.8rem;
  }

  .not-found-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2.2rem;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
  }
</style>
