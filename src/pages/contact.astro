---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Contact & Connect — ${siteConfig.name}`}
  description="Liên hệ và kết nối trực tiếp với tôi qua email và các kênh mạng xã hội."
>
  <div class="container contact-page">
    <SectionHeading
      tag="Get in Touch"
      title="Contact &amp; Connect"
      subtitle="Tôi luôn sẵn sàng lắng nghe các ý tưởng mới, dự án hợp tác hoặc đơn giản là trò chuyện về công nghệ."
    />

    <div class="contact-grid">
      <!-- Main Contact Card -->
      <div class="glass-panel contact-main-card">
        <span class="badge badge-cyan">Direct Email</span>
        <h3 class="contact-card-title text-gradient">Gửi thư trực tiếp</h3>
        <p class="contact-card-desc">
          Cách nhanh nhất và trực tiếp nhất để liên hệ với tôi là thông qua email cá nhân:
        </p>

        <div class="email-box glass-panel">
          <div class="email-text-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="email-icon"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            <span id="email-address-text" class="email-address">{siteConfig.email}</span>
          </div>
          <div class="email-buttons">
            <a href={`mailto:${siteConfig.email}`} class="btn btn-primary btn-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              <span>Mở Email Client</span>
            </a>
            <button id="copy-email-btn" class="btn btn-secondary btn-sm" aria-label="Sao chép địa chỉ email">
              <svg id="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
              <span id="copy-btn-text">Sao chép</span>
            </button>
          </div>
        </div>

        <div class="availability-note">
          <span class="status-live-dot"></span>
          <span>Phản hồi thường trong vòng 24 - 48 giờ làm việc.</span>
        </div>
      </div>

      <!-- Additional Info & Socials -->
      <div class="contact-side-col">
        <div class="glass-panel side-info-card">
          <h4 class="side-card-title text-gradient">Social Profiles</h4>
          <p class="side-card-desc">Kết nối và theo dõi các hoạt động mã nguồn mở của tôi:</p>
          <div class="social-wrapper">
            <SocialLinks showLabels={true} />
          </div>
        </div>

        <div class="glass-panel side-info-card">
          <h4 class="side-card-title text-gradient">Location &amp; Work Mode</h4>
          <div class="location-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>{siteConfig.location} (Múi giờ UTC+7)</span>
          </div>
          <div class="location-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            <span>Làm việc từ xa (Remote) hoặc Hybrid</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-bottom: 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-main-card {
    padding: 2.8rem;
    border-radius: var(--radius-lg);
  }

  .contact-card-title {
    font-size: 1.8rem;
    font-weight: 700;
    margin-top: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .contact-card-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .email-box {
    padding: 1.6rem;
    border-radius: var(--radius-md);
    background: rgba(7, 9, 20, 0.6);
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .email-text-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .email-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .email-address {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: #FFFFFF;
    word-break: break-all;
  }

  .email-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.55rem 1rem;
    font-size: 0.88rem;
  }

  .availability-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .contact-side-col {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .side-info-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
  }

  .side-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .side-card-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }

  .social-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .location-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: #CBD5E1;
    margin-bottom: 0.85rem;
  }

  .location-item:last-child {
    margin-bottom: 0;
  }

  .location-item svg {
    color: var(--accent-cyan);
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function initCopyEmail() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const emailAddressEl = document.getElementById('email-address-text');

    if (copyBtn && copyBtnText && emailAddressEl) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = emailAddressEl.textContent || '';
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtnText.textContent = 'Đã sao chép!';
          copyBtn.style.borderColor = 'var(--accent-emerald)';
          copyBtn.style.color = 'var(--accent-emerald)';
          setTimeout(() => {
            copyBtnText.textContent = 'Sao chép';
            copyBtn.style.borderColor = '';
            copyBtn.style.color = '';
          }, 2500);
        } catch (err) {
          copyBtnText.textContent = 'Lỗi copy';
        }
      });
    }
  })();
</script>
