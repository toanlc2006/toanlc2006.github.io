---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { siteConfig } from '../data/site';
import { projectsData } from '../data/projects';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
function getHref(path: string) {
  if (path === '/') return base ? `${base}/` : '/';
  const cleanPath = path.replace(/^\//, '');
  return base ? `${base}/${cleanPath}` : `/${cleanPath}`;
}

const avatarSrc = base ? `${base}/images/profile/avatar.svg` : '/images/profile/avatar.svg';

// Get featured projects
const featuredProjects = projectsData.filter((p) => p.featured).slice(0, 3);

// Get latest published posts
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const techChips = [
  "Astro", "TypeScript", "JavaScript", "HTML5 & CSS3",
  "Node.js", "Git & GitHub", "GitHub Actions", "REST APIs"
];
---

<BaseLayout
  title={`${siteConfig.name} — Portfolio & Blog`}
  description={siteConfig.tagline}
>
  <!-- Hero Section -->
  <section class="hero-section section-py" aria-label="Introduction">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="status-live-dot"></span>
          <span>{siteConfig.statusBadge}</span>
        </div>

        <p class="hero-greeting">HELLO, WELCOME TO MY SPACE</p>
        <h1 class="hero-title">
          Xin chào, tôi là <br />
          <span class="text-gradient">{siteConfig.name}</span>
        </h1>
        <p class="hero-role">{siteConfig.role}</p>
        <p class="hero-tagline">{siteConfig.tagline}</p>

        <div class="hero-actions">
          <a href={getHref('/projects/')} class="btn btn-primary">
            <span>Explore Projects</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href={getHref('/posts/')} class="btn btn-secondary">
            <span>Read My Posts</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          </a>
        </div>

        <div class="hero-social">
          <span class="social-intro">Liên kết nhanh:</span>
          <SocialLinks />
        </div>
      </div>

      <div class="hero-visual">
        <div class="avatar-card glass-panel animate-float">
          <img
            src={avatarSrc}
            alt="Developer Avatar Placeholder"
            width="380"
            height="380"
            class="avatar-image"
          />
          <div class="avatar-meta">
            <span class="avatar-name">{siteConfig.name}</span>
            <span class="avatar-sub">{siteConfig.location}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="about-preview-section section-py reveal-on-scroll">
    <div class="container">
      <div class="glass-panel about-preview-card">
        <div class="about-preview-text">
          <span class="badge badge-violet">About Me</span>
          <h2 class="about-preview-title text-gradient">Định hướng &amp; Hành trình</h2>
          <p class="about-preview-desc">
            {siteConfig.shortBio} Với mục tiêu xây dựng những trải nghiệm web tinh gọn, tải nhanh và dễ tiếp cận, tôi không ngừng trau dồi các nguyên lý lập trình và kỹ thuật UI/UX hiện đại.
          </p>
          <a href={getHref('/about/')} class="read-more-link">
            <span>Tìm hiểu chi tiết về tôi</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="featured-projects-section section-py reveal-on-scroll">
    <div class="container">
      <div class="section-header-flex">
        <SectionHeading
          tag="Portfolio"
          title="Featured Projects"
          subtitle="Những dự án và bài thực hành tiêu biểu về giao diện web, công cụ tiện ích và kiến trúc mã nguồn."
        />
        <a href={getHref('/projects/')} class="btn btn-secondary view-all-btn">
          <span>Xem tất cả dự án</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="latest-posts-section section-py reveal-on-scroll">
    <div class="container">
      <div class="section-header-flex">
        <SectionHeading
          tag="Knowledge Base"
          title="Latest Posts"
          subtitle="Các bài viết chia sẻ kinh nghiệm lập trình, ghi chú kỹ thuật và đúc kết từ việc học tập hàng ngày."
        />
        <a href={getHref('/posts/')} class="btn btn-secondary view-all-btn">
          <span>Xem tất cả bài viết</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <div class="posts-grid">
        {latestPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Snapshot Section -->
  <section class="tech-snapshot-section section-py reveal-on-scroll">
    <div class="container text-center">
      <SectionHeading
        tag="Skillset"
        title="Tech Snapshot"
        subtitle="Hệ sinh thái công nghệ và bộ công cụ thường xuyên đồng hành trong các dự án."
        align="center"
      />

      <div class="tech-chips-cloud">
        {techChips.map((tech) => (
          <span class="tech-chip-item glass-panel">
            <span class="chip-dot"></span>
            {tech}
          </span>
        ))}
      </div>

      <div class="tech-cta-wrap">
        <a href={getHref('/stack/')} class="btn btn-outline-cyan">
          <span>Xem chi tiết toàn bộ Tech Stack</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Connect CTA Section -->
  <section class="contact-cta-section section-py reveal-on-scroll">
    <div class="container">
      <div class="glass-panel cta-box">
        <div class="cta-inner">
          <span class="badge badge-ember">Let's Connect</span>
          <h2 class="cta-title text-gradient">Bạn có dự án hoặc muốn trao đổi cùng tôi?</h2>
          <p class="cta-desc">
            Tôi luôn hào hứng tìm kiếm các cơ hội thực tập, dự án mã nguồn mở hoặc trao đổi chuyên môn về phát triển web.
          </p>
          <div class="cta-actions">
            <a href={getHref('/contact/')} class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              <span>Liên hệ với tôi</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: #67E8F9;
    margin-bottom: 1.2rem;
  }

  .hero-greeting {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 0.85rem;
  }

  .hero-role {
    font-size: 1.25rem;
    font-weight: 600;
    color: #C4B5FD;
    margin-bottom: 1rem;
  }

  .hero-tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
  }

  .hero-social {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .social-intro {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  /* Avatar Visual */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .avatar-card {
    position: relative;
    padding: 1.25rem;
    border-radius: 28px;
    max-width: 360px;
    width: 100%;
    border-color: rgba(124, 58, 237, 0.25);
  }

  .avatar-image {
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .avatar-meta {
    margin-top: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .avatar-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: #FFFFFF;
  }

  .avatar-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* About Preview Card */
  .about-preview-card {
    padding: 2.8rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(16, 20, 38, 0.7) 0%, rgba(26, 20, 48, 0.6) 100%);
  }

  .about-preview-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 0.6rem;
    margin-bottom: 0.8rem;
  }

  .about-preview-desc {
    font-size: 1.05rem;
    color: #CBD5E1;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 820px;
  }

  /* Section Header Flex */
  .section-header-flex {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .view-all-btn {
    margin-bottom: 2.8rem;
  }

  /* Grids */
  .projects-grid,
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.8rem;
  }

  /* Tech Snapshot */
  .text-center {
    text-align: center;
  }

  .tech-chips-cloud {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    max-width: 780px;
    margin: 0 auto 2.5rem auto;
  }

  .tech-chip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-main);
    border-radius: var(--radius-full);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
  }

  .tech-cta-wrap {
    display: flex;
    justify-content: center;
  }

  /* CTA Box */
  .cta-box {
    padding: 3.5rem 2.5rem;
    text-align: center;
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 50% 30%, rgba(124, 58, 237, 0.15), rgba(16, 20, 38, 0.85) 70%);
  }

  .cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    margin-top: 0.8rem;
    margin-bottom: 0.85rem;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-visual {
      order: -1;
      justify-content: flex-start;
    }
    .avatar-card {
      max-width: 280px;
    }
  }
</style>
