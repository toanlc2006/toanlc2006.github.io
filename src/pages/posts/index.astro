---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostCard from '../../components/PostCard.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

// Fetch all posts, filter drafts in production
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort descending by pubDate
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique categories and tags
const allCategories = ["All", ...new Set(sortedPosts.map((p) => p.data.category))];
const allTags = [...new Set(sortedPosts.flatMap((p) => p.data.tags))];
---

<BaseLayout
  title={`Blog & Posts — ${siteConfig.name}`}
  description="Ghi chép học tập, chia sẻ kinh nghiệm kỹ thuật và kiến thức lập trình web."
>
  <div class="container posts-list-page">
    <SectionHeading
      tag="Writing"
      title="Articles &amp; Notes"
      subtitle="Nơi lưu giữ các kiến thức chuyên môn, bài học kinh nghiệm và giải pháp kỹ thuật qua các dự án."
    />

    <!-- Search & Filter Controls -->
    <div class="posts-filter-container glass-panel">
      <!-- Search Input -->
      <div class="search-input-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input
          type="text"
          id="post-search-input"
          class="post-search-input"
          placeholder="Tìm bài viết theo tiêu đề, mô tả hoặc từ khóa..."
          aria-label="Tìm kiếm bài viết"
        />
        <button id="clear-search-btn" class="clear-search-btn" aria-label="Xóa từ khóa tìm kiếm" style="display: none;">
          &times;
        </button>
      </div>

      <!-- Category Filter Pills -->
      <div class="categories-filter-row">
        <span class="filter-label">Chuyên mục:</span>
        <div class="category-pills">
          {allCategories.map((cat, idx) => (
            <button
              class:list={["cat-btn", { active: idx === 0 }]}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Popular Tags Row -->
      {allTags.length > 0 && (
        <div class="tags-filter-row">
          <span class="filter-label">Tags:</span>
          <div class="tag-pills">
            {allTags.map((tag) => (
              <button class="tag-btn" data-tag={tag}>
                #{tag}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Posts Count Indicator -->
    <div class="posts-count-bar">
      <span>
        Hiển thị: <strong id="posts-count">{sortedPosts.length}</strong> bài viết
      </span>
      <button id="reset-all-filters" class="reset-link" style="display: none;">
        Đặt lại bộ lọc
      </button>
    </div>

    <!-- Posts Grid -->
    <div class="posts-grid" id="posts-grid">
      {sortedPosts.map((post) => (
        <div
          class="post-item"
          data-title={post.data.title.toLowerCase()}
          data-desc={post.data.description.toLowerCase()}
          data-category={post.data.category}
          data-tags={post.data.tags.map((t) => t.toLowerCase()).join(',')}
        >
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-posts-state" class="glass-panel empty-posts-state" style="display: none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      <h3 class="empty-state-title">Không tìm thấy bài viết nào</h3>
      <p class="empty-state-desc">Hãy thử thay đổi từ khóa tìm kiếm hoặc chọn chuyên mục khác.</p>
      <button id="empty-reset-btn" class="btn btn-secondary">Đặt lại tìm kiếm</button>
    </div>
  </div>
</BaseLayout>

<style>
  .posts-list-page {
    padding-bottom: 4rem;
  }

  .posts-filter-container {
    padding: 1.8rem;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .post-search-input {
    width: 100%;
    padding: 0.85rem 2.8rem 0.85rem 2.8rem;
    background: rgba(7, 9, 20, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: #FFFFFF;
    font-size: 0.95rem;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .post-search-input:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(34, 211, 238, 0.25);
  }

  .clear-search-btn {
    position: absolute;
    right: 1rem;
    font-size: 1.3rem;
    color: var(--text-muted);
    padding: 0 0.4rem;
  }

  .categories-filter-row,
  .tags-filter-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dim);
    min-width: 85px;
  }

  .category-pills,
  .tag-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    padding: 0.35rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
  }

  .cat-btn:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  .cat-btn.active {
    background: var(--accent-violet);
    border-color: var(--accent-violet);
    color: #FFFFFF;
    box-shadow: 0 0 10px rgba(124, 58, 237, 0.4);
  }

  .tag-btn {
    padding: 0.25rem 0.65rem;
    font-size: 0.78rem;
    color: #94A3B8;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px dashed rgba(255, 255, 255, 0.12);
    transition: all var(--transition-fast);
  }

  .tag-btn:hover,
  .tag-btn.active {
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
    background: rgba(34, 211, 238, 0.08);
  }

  .posts-count-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .reset-link {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    text-decoration: underline;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .empty-posts-state {
    text-align: center;
    padding: 4rem 2rem;
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    max-width: 520px;
    margin: 2rem auto;
  }

  .empty-state-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .empty-state-desc {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
</style>

<script>
  (function initPostFiltering() {
    const searchInput = document.getElementById('post-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const catBtns = document.querySelectorAll('.cat-btn');
    const tagBtns = document.querySelectorAll('.tag-btn');
    const items = document.querySelectorAll<HTMLElement>('.post-item');
    const countEl = document.getElementById('posts-count');
    const resetAllBtn = document.getElementById('reset-all-filters');
    const emptyState = document.getElementById('no-posts-state');
    const emptyResetBtn = document.getElementById('empty-reset-btn');

    let currentCategory = 'All';
    let currentTag = '';
    let searchQuery = '';

    function filterPosts() {
      let visibleCount = 0;
      const query = searchQuery.trim().toLowerCase();

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const cat = item.getAttribute('data-category') || '';
        const tags = item.getAttribute('data-tags') || '';

        const matchesSearch = !query || title.includes(query) || desc.includes(query) || tags.includes(query);
        const matchesCategory = currentCategory === 'All' || cat === currentCategory;
        const matchesTag = !currentTag || tags.includes(currentTag.toLowerCase());

        if (matchesSearch && matchesCategory && matchesTag) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = String(visibleCount);
      if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      if (clearBtn) clearBtn.style.display = query.length > 0 ? 'block' : 'none';

      const hasActiveFilters = currentCategory !== 'All' || currentTag !== '' || query.length > 0;
      if (resetAllBtn) resetAllBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        filterPosts();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        filterPosts();
      });
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'All';
        catBtns.forEach((b) => b.classList.toggle('active', b === btn));
        filterPosts();
      });
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        if (currentTag === tag) {
          currentTag = '';
          btn.classList.remove('active');
        } else {
          currentTag = tag;
          tagBtns.forEach((b) => b.classList.toggle('active', b === btn));
        }
        filterPosts();
      });
    });

    function resetFilters() {
      currentCategory = 'All';
      currentTag = '';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      catBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-category') === 'All'));
      tagBtns.forEach((b) => b.classList.remove('active'));
      filterPosts();
    }

    if (resetAllBtn) resetAllBtn.addEventListener('click', resetFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetFilters);
  })();
</script>
