---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectsData } from '../data/projects';
import { siteConfig } from '../data/site';

const categories = ["All", "Web", "JavaScript", "Academic"];
---

<BaseLayout
  title={`Projects — ${siteConfig.name}`}
  description="Bộ sưu tập các dự án phần mềm, ứng dụng web và công cụ lập trình đã thực hiện."
>
  <div class="container projects-page">
    <SectionHeading
      tag="Showcase"
      title="Projects &amp; Experiments"
      subtitle="Danh sách các dự án thực tế, mã nguồn và sản phẩm thực nghiệm của tôi."
    />

    <!-- Filter Buttons Bar -->
    <div class="filter-controls-bar">
      <div class="filter-pill-group" role="tablist" aria-label="Filter projects by category">
        {categories.map((cat, idx) => (
          <button
            class:list={["filter-btn", { active: idx === 0 }]}
            data-category={cat}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="project-count-indicator">
        Hiển thị: <span id="visible-count">{projectsData.length}</span>/{projectsData.length} dự án
      </div>
    </div>

    <!-- Projects Grid Container -->
    <div class="projects-grid" id="projects-grid">
      {projectsData.map((project) => (
        <div class="project-item" data-category={project.category}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <!-- Empty Filter State -->
    <div id="no-projects-msg" class="glass-panel empty-state" style="display: none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <h3 class="empty-title">Không tìm thấy dự án phù hợp</h3>
      <p class="empty-desc">Hãy thử chọn danh mục khác hoặc nhấn "All" để xem tất cả dự án.</p>
      <button id="reset-filter-btn" class="btn btn-secondary">Xem tất cả</button>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding-bottom: 4rem;
  }

  .filter-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-pill-group {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.35rem;
    background: rgba(16, 20, 38, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    backdrop-filter: blur(10px);
  }

  .filter-btn {
    padding: 0.45rem 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--text-main);
  }

  .filter-btn.active {
    background: var(--accent-violet);
    color: #FFFFFF;
    box-shadow: 0 0 12px rgba(124, 58, 237, 0.45);
  }

  .project-count-indicator {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    border-radius: var(--radius-lg);
    color: var(--text-muted);
    max-width: 500px;
    margin: 2rem auto;
  }

  .empty-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
</style>

<script>
  (function initProjectsFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item');
    const countEl = document.getElementById('visible-count');
    const emptyMsg = document.getElementById('no-projects-msg');
    const resetBtn = document.getElementById('reset-filter-btn');

    function applyFilter(category: string) {
      let visible = 0;

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (category === 'All' || itemCat === category) {
          item.style.display = 'block';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = String(visible);
      if (emptyMsg) {
        emptyMsg.style.display = visible === 0 ? 'block' : 'none';
      }

      filterBtns.forEach((btn) => {
        const isActive = btn.getAttribute('data-category') === category;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', String(isActive));
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'All';
        applyFilter(cat);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        applyFilter('All');
      });
    }
  })();
</script>
